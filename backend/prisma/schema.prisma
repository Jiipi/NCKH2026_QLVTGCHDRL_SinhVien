generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lop {
  id             String     @id @default(uuid()) @db.Uuid
  ten_lop        String     @unique @db.VarChar(30)
  khoa           String     @db.VarChar(50)
  nien_khoa      String     @db.VarChar(20)
  nam_nhap_hoc   DateTime   @db.Date
  nam_tot_nghiep DateTime?  @db.Date
  chu_nhiem      String     @db.Uuid
  lop_truong     String?    @db.Uuid
  chu_nhiem_rel  NguoiDung  @relation("ChuNhiemLop", fields: [chu_nhiem], references: [id])
  lop_truong_rel SinhVien?  @relation("LopTruongLop", fields: [lop_truong], references: [id])
  sinh_viens     SinhVien[] @relation("SinhVienLop")
  hoat_dongs     HoatDong[] @relation("LopHoatDong")

  @@index([chu_nhiem])
  @@map("lop")
}

model VaiTro {
  id          String      @id @default(uuid()) @db.Uuid
  ten_vt      String      @unique @db.VarChar(50)
  mo_ta       String?
  quyen_han   Json?
  ngay_tao    DateTime    @default(now()) @db.Timestamp(6)
  nguoi_dungs NguoiDung[]

  @@map("vai_tro")
}

model NguoiDung {
  id                      String                  @id @default(uuid()) @db.Uuid
  ten_dn                  String                  @unique @db.VarChar(50)
  mat_khau                String                  @db.VarChar(255)
  email                   String                  @unique @db.VarChar(100)
  ho_ten                  String?                 @db.VarChar(50)
  vai_tro_id              String                  @db.Uuid
  trang_thai              TrangThaiTaiKhoan       @default(hoat_dong)
  ngay_tao                DateTime                @default(now()) @db.Timestamp(6)
  ngay_cap_nhat           DateTime                @default(now()) @updatedAt @db.Timestamp(6)
  lan_cuoi_dn             DateTime?               @db.Timestamp(6)
  token_reset             String?                 @db.VarChar(255)
  tg_het_han_token        DateTime?               @db.Timestamp(6)
  // Trường tiếng Việt để quản lý OTP (song song với token_reset để tương thích)
  ma_xac_minh             String?                 @db.VarChar(255)
  tg_het_han_ma           DateTime?               @db.Timestamp(6)
  anh_dai_dien            String?                 @db.VarChar(255)
  diem_danh_thuc_hien     DiemDanh[]              @relation("NguoiDiemDanh")
  hoat_dong_tao           HoatDong[]              @relation("NguoiTaoHoatDong")
  lops_chu_nhiem          Lop[]                   @relation("ChuNhiemLop")
  vai_tro                 VaiTro                  @relation(fields: [vai_tro_id], references: [id])
  sinh_vien               SinhVien?
  thong_bao_gui           ThongBao[]              @relation("NguoiGuiThongBao")
  thong_bao_nhan          ThongBao[]              @relation("NguoiNhanThongBao")
  phien_dang_nhap         PhienDangNhap[]
  dang_ky_duyet           DangKyHoatDong[]        @relation("NguoiDuyetDangKy")
  yeu_cau_diem_danh_duyet YeuCauDiemDanhThuCong[] @relation("NguoiDuyetYeuCauDiemDanhThuCong")
  phien_qr_tao            PhienDiemDanhQr[]       @relation("NguoiTaoPhienQr")
  audit_diem_danh         NhatKyDiemDanh[]        @relation("NguoiThucHienAuditDiemDanh")
  import_jobs             ImportJob[]             @relation("NguoiTaoImportJob")
  khoa_van_tay            KhoaVanTay[]
  thu_thach_van_tay       ThuThachVanTay[]

  @@map("nguoi_dung")
}

model PhienDangNhap {
  id            String    @id @default(uuid()) @db.Uuid
  nguoi_dung_id String    @db.Uuid
  ma_tab        String    @unique @db.VarChar(255)
  vai_tro       String?   @db.VarChar(50)
  thoi_gian_tao DateTime  @default(now()) @db.Timestamp(6)
  lan_hoat_dong DateTime  @updatedAt @db.Timestamp(6)
  nguoi_dung    NguoiDung @relation(fields: [nguoi_dung_id], references: [id])

  @@index([nguoi_dung_id])
  @@index([ma_tab])
  @@map("phien_dang_nhap")
}

model SinhVien {
  id                         String                  @id @default(uuid()) @db.Uuid
  nguoi_dung_id              String                  @unique @db.Uuid
  mssv                       String                  @unique @db.VarChar(10)
  ngay_sinh                  DateTime                @db.Date
  gt                         GioiTinh?
  lop_id                     String                  @db.Uuid
  dia_chi                    String?
  sdt                        String?                 @db.VarChar(10)
  email                      String?                 @db.VarChar(100)
  dang_ky_hd                 DangKyHoatDong[]
  diem_danh                  DiemDanh[]
  lop_truong                 Lop[]                   @relation("LopTruongLop")
  lop                        Lop                     @relation("SinhVienLop", fields: [lop_id], references: [id])
  nguoi_dung                 NguoiDung               @relation(fields: [nguoi_dung_id], references: [id])
  // Dữ liệu nhận diện khuôn mặt (1-1 relation)
  du_lieu_khuon_mat          DuLieuKhuonMat?
  // Đồng ý sinh trắc học
  dong_y_sinh_trac_hoc       DongYSinhTracHoc[]
  audit_diem_danh            NhatKyDiemDanh[]
  yeu_cau_diem_danh_thu_cong YeuCauDiemDanhThuCong[]

  @@index([lop_id])
  @@map("sinh_vien")
}

/// Model lưu trữ dữ liệu nhận diện khuôn mặt của sinh viên
/// Sử dụng embedding vector 512 chiều từ ArcFace
model DuLieuKhuonMat {
  id               String   @id @default(uuid()) @db.Uuid
  sinh_vien_id     String   @unique @db.Uuid
  // Vector embedding 512 chiều từ ArcFace (lưu dưới dạng mảng Float)
  vector_dac_trung Float[]  @db.DoublePrecision
  // Đường dẫn ảnh khuôn mặt đã căn chỉnh (tùy chọn, để xác minh)
  anh_khuon_mat    String?  @db.Text
  anh_khuon_mat_ds Json?
  // Trạng thái: đã xác minh hay chưa
  da_xac_minh      Boolean  @default(false)
  // Số lượng ảnh đã dùng để tạo embedding
  so_anh_dang_ky   Int      @default(1)
  // Model metadata (version tracking)
  model_name       String?  @db.VarChar(50)
  model_version    String?  @db.VarChar(30)
  embedding_dim    Int      @default(512)
  threshold_used   Float?   @db.DoublePrecision
  ngay_tao         DateTime @default(now()) @db.Timestamp(6)
  ngay_cap_nhat    DateTime @default(now()) @updatedAt @db.Timestamp(6)
  // Relation
  sinh_vien        SinhVien @relation(fields: [sinh_vien_id], references: [id], onDelete: Cascade)

  @@map("du_lieu_khuon_mat")
}

/// Model lưu trữ đồng ý sinh trắc học của sinh viên
model DongYSinhTracHoc {
  id              String    @id @default(uuid()) @db.Uuid
  sinh_vien_id    String    @db.Uuid
  consent_version String    @db.VarChar(20)
  accepted_at     DateTime  @default(now()) @db.Timestamp(6)
  revoked_at      DateTime? @db.Timestamp(6)
  ip_address      String?   @db.VarChar(80)
  user_agent      String?
  sinh_vien       SinhVien  @relation(fields: [sinh_vien_id], references: [id], onDelete: Cascade)

  @@index([sinh_vien_id, consent_version])
  @@map("dong_y_sinh_trac_hoc")
}

model LoaiHoatDong {
  id            String     @id @default(uuid()) @db.Uuid
  ten_loai_hd   String     @unique @db.VarChar(50)
  mo_ta         String?
  diem_mac_dinh Decimal    @default(0.00) @db.Decimal(4, 2)
  diem_toi_da   Decimal    @default(10.00) @db.Decimal(4, 2)
  mau_sac       String?    @db.VarChar(7)
  nguoi_tao_id  String?    @db.Uuid
  ngay_tao      DateTime   @default(now()) @db.Timestamp(6)
  hoat_dongs    HoatDong[]

  @@map("loai_hoat_dong")
}

model HoatDong {
  id                         String                  @id @default(uuid()) @db.Uuid
  ma_hd                      String?                 @unique @db.VarChar(50)
  ten_hd                     String                  @db.VarChar(200)
  mo_ta                      String?
  loai_hd_id                 String                  @db.Uuid
  lop_id                     String?                 @db.Uuid
  diem_rl                    Decimal                 @default(0.00) @db.Decimal(4, 2)
  dia_diem                   String?                 @db.VarChar(200)
  geo_latitude               Decimal?                @db.Decimal(10, 7)
  geo_longitude              Decimal?                @db.Decimal(10, 7)
  geo_radius_meters          Int?                    @default(100)
  yeu_cau_gps                Boolean                 @default(false)
  cho_phep_fallback          Boolean                 @default(true)
  ngay_bd                    DateTime                @db.Timestamp(6)
  ngay_kt                    DateTime                @db.Timestamp(6)
  han_dk                     DateTime?               @db.Timestamp(6)
  sl_toi_da                  Int                     @default(1)
  don_vi_to_chuc             String?
  yeu_cau_tham_gia           String?
  trang_thai                 TrangThaiHoatDong       @default(cho_duyet)
  ly_do_tu_choi              String?
  qr                         String?                 @unique @db.VarChar(32)
  hinh_anh                   String[]
  tep_dinh_kem               String[]
  nguoi_tao_id               String                  @db.Uuid
  ngay_tao                   DateTime                @default(now()) @db.Timestamp(6)
  ngay_cap_nhat              DateTime                @default(now()) @updatedAt @db.Timestamp(6)
  co_chung_chi               Boolean                 @default(false)
  hoc_ky                     HocKy                   @default(hoc_ky_1)
  nam_hoc                    String?                 @db.VarChar(15)
  dang_ky_hd                 DangKyHoatDong[]
  diem_danh                  DiemDanh[]
  phien_qr                   PhienDiemDanhQr[]
  audit_diem_danh            NhatKyDiemDanh[]
  yeu_cau_diem_danh_thu_cong YeuCauDiemDanhThuCong[]
  thu_thach_van_tay          ThuThachVanTay[]
  loai_hd                    LoaiHoatDong            @relation(fields: [loai_hd_id], references: [id])
  nguoi_tao                  NguoiDung               @relation("NguoiTaoHoatDong", fields: [nguoi_tao_id], references: [id])
  lop                        Lop?                    @relation("LopHoatDong", fields: [lop_id], references: [id])

  @@index([hoc_ky, nam_hoc])
  @@index([lop_id, hoc_ky, nam_hoc])
  @@index([nguoi_tao_id, hoc_ky, nam_hoc])
  @@index([trang_thai, hoc_ky, nam_hoc])
  @@map("hoat_dong")
}

model DangKyHoatDong {
  id             String          @id @default(uuid()) @db.Uuid
  sv_id          String          @db.Uuid
  hd_id          String          @db.Uuid
  ngay_dang_ky   DateTime        @default(now()) @db.Timestamp(6)
  trang_thai_dk  TrangThaiDangKy @default(cho_duyet)
  ly_do_dk       String?
  ly_do_tu_choi  String?
  ngay_duyet     DateTime?       @db.Timestamp(6)
  nguoi_duyet_id String?         @db.Uuid
  ghi_chu        String?
  hoat_dong      HoatDong        @relation(fields: [hd_id], references: [id])
  sinh_vien      SinhVien        @relation(fields: [sv_id], references: [id])
  nguoi_duyet    NguoiDung?      @relation("NguoiDuyetDangKy", fields: [nguoi_duyet_id], references: [id])

  @@unique([sv_id, hd_id])
  @@index([sv_id, trang_thai_dk])
  @@index([hd_id, trang_thai_dk])
  @@map("dang_ky_hoat_dong")
}

model DiemDanh {
  id                   String                 @id @default(uuid()) @db.Uuid
  nguoi_diem_danh_id   String                 @db.Uuid
  sv_id                String                 @db.Uuid
  hd_id                String                 @db.Uuid
  tg_diem_danh         DateTime               @default(now()) @db.Timestamp(6)
  phuong_thuc          PhuongThucDiemDanh     @default(qr)
  trang_thai_tham_gia  TrangThaiThamGia       @default(co_mat)
  ghi_chu              String?
  dia_chi_ip           String?                @db.Inet
  vi_tri_gps           String?
  gps_latitude         Decimal?               @db.Decimal(10, 7)
  gps_longitude        Decimal?               @db.Decimal(10, 7)
  gps_accuracy_m       Float?
  khoang_cach_m        Float?
  ket_qua_geofence     KetQuaGeofence?
  fallback_request_id  String?                @db.Uuid
  khoa_van_tay_id      String?                @db.Uuid
  xac_nhan_tham_gia    Boolean                @default(true)
  // Độ tin cậy nhận diện khuôn mặt (0.0 - 1.0), chỉ có giá trị khi phuong_thuc = khuon_mat
  do_tin_cay_nhan_dien Float?                 @db.DoublePrecision
  hoat_dong            HoatDong               @relation(fields: [hd_id], references: [id])
  nguoi_diem_danh      NguoiDung              @relation("NguoiDiemDanh", fields: [nguoi_diem_danh_id], references: [id])
  sinh_vien            SinhVien               @relation(fields: [sv_id], references: [id])
  fallback_request     YeuCauDiemDanhThuCong? @relation(fields: [fallback_request_id], references: [id], onDelete: SetNull)
  khoa_van_tay         KhoaVanTay?            @relation(fields: [khoa_van_tay_id], references: [id], onDelete: SetNull)
  audit_diem_danh      NhatKyDiemDanh[]

  @@unique([sv_id, hd_id])
  @@map("diem_danh")
}

model KhoaVanTay {
  id                String     @id @default(uuid()) @db.Uuid
  nguoi_dung_id     String     @db.Uuid
  credential_id     String     @unique @db.Text
  public_key        Json
  counter           Int        @default(0)
  transports        String[]
  ten_thiet_bi      String?    @db.VarChar(120)
  da_kich_hoat      Boolean    @default(true)
  ngay_tao          DateTime   @default(now()) @db.Timestamp(6)
  ngay_cap_nhat     DateTime   @default(now()) @updatedAt @db.Timestamp(6)
  lan_su_dung_cuoi  DateTime?  @db.Timestamp(6)
  nguoi_dung        NguoiDung  @relation(fields: [nguoi_dung_id], references: [id], onDelete: Cascade)
  diem_danh         DiemDanh[]

  @@index([nguoi_dung_id, da_kich_hoat])
  @@map("khoa_van_tay")
}

model ThuThachVanTay {
  id               String         @id @default(uuid()) @db.Uuid
  nguoi_dung_id    String?        @db.Uuid
  challenge        String         @unique @db.VarChar(255)
  muc_dich         MucDichVanTay
  hoat_dong_id     String?        @db.Uuid
  het_han_luc      DateTime       @db.Timestamp(6)
  da_su_dung_luc   DateTime?      @db.Timestamp(6)
  dia_chi_ip       String?        @db.VarChar(80)
  user_agent       String?
  ngay_tao         DateTime       @default(now()) @db.Timestamp(6)
  nguoi_dung       NguoiDung?     @relation(fields: [nguoi_dung_id], references: [id], onDelete: Cascade)
  hoat_dong        HoatDong?      @relation(fields: [hoat_dong_id], references: [id], onDelete: Cascade)

  @@index([nguoi_dung_id, muc_dich, het_han_luc])
  @@index([hoat_dong_id, muc_dich, het_han_luc])
  @@map("thu_thach_van_tay")
}

model PhienDiemDanhQr {
  id              String           @id @default(uuid()) @db.Uuid
  hd_id           String           @db.Uuid
  nguoi_tao_id    String           @db.Uuid
  trang_thai      TrangThaiPhienQr @default(dang_mo)
  het_han_luc     DateTime         @db.Timestamp(6)
  ngay_tao        DateTime         @default(now()) @db.Timestamp(6)
  ngay_cap_nhat   DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  hoat_dong       HoatDong         @relation(fields: [hd_id], references: [id], onDelete: Cascade)
  nguoi_tao       NguoiDung        @relation("NguoiTaoPhienQr", fields: [nguoi_tao_id], references: [id])
  tokens          MaDiemDanhQr[]
  audit_diem_danh NhatKyDiemDanh[]

  @@index([hd_id, trang_thai])
  @@index([het_han_luc])
  @@map("phien_diem_danh_qr")
}

model MaDiemDanhQr {
  id              String           @id @default(uuid()) @db.Uuid
  phien_id        String           @db.Uuid
  token_hash      String           @unique @db.Char(64)
  het_han_luc     DateTime         @db.Timestamp(6)
  da_su_dung_luc  DateTime?        @db.Timestamp(6)
  ngay_tao        DateTime         @default(now()) @db.Timestamp(6)
  phien           PhienDiemDanhQr  @relation(fields: [phien_id], references: [id], onDelete: Cascade)
  audit_diem_danh NhatKyDiemDanh[]

  @@index([phien_id, het_han_luc])
  @@map("ma_diem_danh_qr")
}

model YeuCauDiemDanhThuCong {
  id             String                  @id @default(uuid()) @db.Uuid
  sv_id          String                  @db.Uuid
  hd_id          String                  @db.Uuid
  nguoi_duyet_id String?                 @db.Uuid
  ly_do          String
  minh_chung     String[]
  gps_latitude   Decimal?                @db.Decimal(10, 7)
  gps_longitude  Decimal?                @db.Decimal(10, 7)
  gps_accuracy_m Float?
  dia_chi_ip     String?                 @db.Inet
  user_agent     String?
  trang_thai     TrangThaiYeuCauDiemDanh @default(cho_duyet)
  ghi_chu_duyet  String?
  ngay_tao       DateTime                @default(now()) @db.Timestamp(6)
  ngay_duyet     DateTime?               @db.Timestamp(6)
  hoat_dong      HoatDong                @relation(fields: [hd_id], references: [id], onDelete: Cascade)
  sinh_vien      SinhVien                @relation(fields: [sv_id], references: [id], onDelete: Cascade)
  nguoi_duyet    NguoiDung?              @relation("NguoiDuyetYeuCauDiemDanhThuCong", fields: [nguoi_duyet_id], references: [id], onDelete: SetNull)
  diem_danh      DiemDanh[]

  @@unique([sv_id, hd_id])
  @@index([hd_id, trang_thai])
  @@index([sv_id, trang_thai])
  @@index([nguoi_duyet_id])
  @@map("yeu_cau_diem_danh_thu_cong")
}

model NhatKyDiemDanh {
  id                 String           @id @default(uuid()) @db.Uuid
  hanh_dong          String           @db.VarChar(50)
  ket_qua            String           @db.VarChar(20)
  nguoi_thuc_hien_id String?          @db.Uuid
  sinh_vien_id       String?          @db.Uuid
  hoat_dong_id       String?          @db.Uuid
  phien_qr_id        String?          @db.Uuid
  ma_qr_id           String?          @db.Uuid
  diem_danh_id       String?          @db.Uuid
  ly_do              String?          @db.VarChar(100)
  dia_chi_ip         String?          @db.Inet
  user_agent         String?
  metadata           Json?
  thoi_gian          DateTime         @default(now()) @db.Timestamp(6)
  nguoi_thuc_hien    NguoiDung?       @relation("NguoiThucHienAuditDiemDanh", fields: [nguoi_thuc_hien_id], references: [id], onDelete: SetNull)
  sinh_vien          SinhVien?        @relation(fields: [sinh_vien_id], references: [id], onDelete: SetNull)
  hoat_dong          HoatDong?        @relation(fields: [hoat_dong_id], references: [id], onDelete: SetNull)
  phien_qr           PhienDiemDanhQr? @relation(fields: [phien_qr_id], references: [id], onDelete: SetNull)
  ma_qr              MaDiemDanhQr?    @relation(fields: [ma_qr_id], references: [id], onDelete: SetNull)
  diem_danh          DiemDanh?        @relation(fields: [diem_danh_id], references: [id], onDelete: SetNull)

  @@index([thoi_gian])
  @@index([hanh_dong, ket_qua, thoi_gian])
  @@index([nguoi_thuc_hien_id, thoi_gian])
  @@index([sinh_vien_id, thoi_gian])
  @@index([hoat_dong_id, thoi_gian])
  @@index([dia_chi_ip, thoi_gian])
  @@map("nhat_ky_diem_danh")
}

model ImportJob {
  id              String           @id @default(uuid()) @db.Uuid
  type            ImportType
  filename        String           @db.VarChar(255)
  status          ImportStatus     @default(pending)
  total_rows      Int              @default(0)
  valid_rows      Int              @default(0)
  invalid_rows    Int              @default(0)
  preview_payload Json?
  created_by      String           @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  completed_at    DateTime?        @db.Timestamp(6)
  nguoi_tao       NguoiDung        @relation("NguoiTaoImportJob", fields: [created_by], references: [id], onDelete: Cascade)
  errors          ImportJobError[]

  @@index([created_by, created_at])
  @@index([type, status, created_at])
  @@map("import_job")
}

model ImportJobError {
  id            String    @id @default(uuid()) @db.Uuid
  import_job_id String    @db.Uuid
  row_number    Int
  field         String?   @db.VarChar(100)
  message       String
  raw_value     String?   @db.Text
  job           ImportJob @relation(fields: [import_job_id], references: [id], onDelete: Cascade)

  @@index([import_job_id, row_number])
  @@map("import_job_error")
}

model NhatKyToanVenDuLieu {
  id            String   @id @default(uuid()) @db.Uuid
  chain_scope   String   @default("global") @db.VarChar(80)
  sequence      Int
  entity_type   String   @db.VarChar(80)
  entity_id     String?  @db.VarChar(120)
  action        String   @db.VarChar(120)
  actor_id      String?  @db.Uuid
  request_id    String?  @db.VarChar(120)
  ip_address    String?  @db.VarChar(80)
  user_agent    String?
  payload       Json
  payload_hash  String   @db.Char(64)
  previous_hash String?  @db.Char(64)
  record_hash   String   @unique @db.Char(64)
  created_at    DateTime @default(now()) @db.Timestamp(6)

  @@unique([chain_scope, sequence])
  @@index([entity_type, entity_id])
  @@index([chain_scope, created_at])
  @@map("nhat_ky_toan_ven_du_lieu")
}

model LoaiThongBao {
  id          String     @id @default(uuid()) @db.Uuid
  ten_loai_tb String     @unique @db.VarChar(50)
  mo_ta       String?
  thong_baos  ThongBao[]

  @@map("loai_thong_bao")
}

model ThongBao {
  id                 String        @id @default(uuid()) @db.Uuid
  tieu_de            String        @db.VarChar(200)
  noi_dung           String
  // Metadata gửi broadcast (tùy chọn; chỉ set cho thông báo dạng broadcast)
  pham_vi_gui        String?       @db.VarChar(30)
  vai_tro_nhan       String?       @db.VarChar(50)
  lop_nhan_id        String?       @db.Uuid
  khoa_nhan          String?       @db.VarChar(100)
  hoat_dong_nhan_id  String?       @db.Uuid
  so_nguoi_duoc_chon Int?
  so_nguoi_da_gui    Int?
  loai_tb_id         String        @db.Uuid
  nguoi_gui_id       String        @db.Uuid
  nguoi_nhan_id      String        @db.Uuid
  da_doc             Boolean       @default(false)
  muc_do_uu_tien     MucDoUuTien   @default(trung_binh)
  ngay_gui           DateTime      @default(now()) @db.Timestamp(6)
  ngay_doc           DateTime?     @db.Timestamp(6)
  trang_thai_gui     TrangThaiGui?
  phuong_thuc_gui    PhuongThucGui @default(email)
  loai_tb            LoaiThongBao  @relation(fields: [loai_tb_id], references: [id])
  nguoi_gui          NguoiDung     @relation("NguoiGuiThongBao", fields: [nguoi_gui_id], references: [id])
  nguoi_nhan         NguoiDung     @relation("NguoiNhanThongBao", fields: [nguoi_nhan_id], references: [id])

  @@map("thong_bao")
}

